# EnvironmentFile for the nbu_exporter systemd unit.
# Supplies every ${VAR} referenced in config.yaml (the shipped config.yaml needs
# NBU1_HOSTNAME and NBU1_APIKEY; startup fails if one is unset).
#
# Install:  /etc/nbu_exporter/nbu_exporter.env   (chmod 0600, chown root:nbu)

NBU1_HOSTNAME=master.my.domain
NBU1_APIKEY=change-me
NBU1_SKIP_CERTIFICATE=false

# Second master — only read when its nbuservers: entry is uncommented in config.yaml.
# NBU2_HOSTNAME=master2.my.domain
# NBU2_APIKEY=change-me
# NBU2_SKIP_CERTIFICATE=false

# Trust the NetBackup CA (keep certificate verification on), see docs/deploy-stack.md §10:
# SSL_CERT_DIR=/etc/ssl/certs:/etc/nbu_exporter/ca
